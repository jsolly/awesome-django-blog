{
	"name": "awesome-django-blog-tooling",
	"private": true,
	"description": "Dev tooling only (heroku CLI) — the app itself is Python/Django",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"check:md": "bash scripts/lint-md.sh",
		"check:yaml": "yamllint -s .",
		"worktree:init": "bash scripts/worktree-init.sh",
		"check:actions": "bash scripts/check-actions.sh",
		"gate": "FLEET_DOC_FAST=0 bash .git-hooks/pre-commit"
	},
	"devDependencies": {
		"github-actionlint": "^1.7.12",
		"heroku": "^11.10.0",
		"markdownlint-cli2": "0.23.2"
	},
	"overrides": {
		"adm-zip": "0.6.0"
	},
	"allowScripts": {
		"cpu-features@0.0.10": true,
		"protobufjs@7.6.6": true,
		"ssh2@1.17.0": true,
		"yarn@1.22.22": true
	}
}
